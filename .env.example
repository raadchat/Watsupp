# =============================================================
# انسخ هذا الملف باسم .env واملأ القيم الحقيقية.
# .env نفسه لا يجب أبداً أن يُرفع إلى Git (موجود في .gitignore).
# =============================================================

# ---- الخادم ----
PORT=3000
NODE_ENV=development

# الرابط العام الذي يصل إليه الإنترنت لخادمك — مطلوب فقط لإرسال صورة
# رسالة الترحيب (Meta يجب أن يستطيع تحميل الصورة من رابط عام، وليس
# localhost). اتركه فارغاً أثناء التطوير المحلي بلا صور؛ اضبطه على نطاقك
# الحقيقي بعد النشر، أو رابط ngrok مؤقتاً أثناء التجربة.
# مثال: PUBLIC_BASE_URL=https://app.example.com
PUBLIC_BASE_URL=

# ---- المصادقة JWT ----
# استخدم سلسلة عشوائية طويلة، مثال لتوليدها:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

# ---- قاعدة البيانات ----
# في هذا التنفيذ: مسار ملف SQLite (نسبي لمجلد تشغيل المشروع)
DATABASE_URL=./backend/database/bot.db

# ---- تشفير كلمات المرور ----
BCRYPT_SALT_ROUNDS=12

# ---- WhatsApp Cloud API (Meta) ----
# اختياري الآن: الطريقة المفضّلة هي ضبطها من صفحة "الاتصال بواتساب" داخل
# لوحة التحكم بعد تسجيل الدخول (تُحفظ في قاعدة البيانات، مع اختبار اتصال
# فوري). القيم هنا تُستخدم فقط كتراجع إن لم تُضبط بعد من اللوحة.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# (اختياري) App Secret من إعدادات تطبيق Meta — إذا ضُبط، يُستخدم مستقبلاً
# للتحقق من توقيع طلبات الـ webhook الواردة (تعزيز أمني إضافي غير إلزامي)
# WHATSAPP_APP_SECRET=

# ---- حدود الطلبات (Rate Limiting) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# ---- طابور الرسائل الجماعية ----
# التأخير بالمللي ثانية بين كل رسالة والتي تليها في الإرسال الجماعي
BULK_MESSAGE_DELAY_MS=1200

# ---- CORS ----
# اضبطه على نطاق لوحة التحكم الفعلي عند النشر بدل *
CORS_ORIGIN=*
JWT_SECRET=super_secret_key_raad_chat_2026_x9812345
