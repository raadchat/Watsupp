# =============================================================
# انسخ هذا الملف باسم .env واملأ القيم الحقيقية.
# .env نفسه لا يجب أبداً أن يُرفع إلى Git (موجود في .gitignore).
# =============================================================

# ---- الخادم ----
PORT=3000
NODE_ENV=development

# ---- المصادقة JWT ----
# استخدم سلسلة عشوائية طويلة، مثال لتوليدها:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

# ---- قاعدة البيانات ----
# في هذا التنفيذ: مسار ملف SQLite (نسبي لمجلد تشغيل المشروع)
DATABASE_URL=./backend/database/bot.db

# ---- تشفير كلمات المرور ----
BCRYPT_SALT_ROUNDS=12

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=EABlk3qv6kyoBScyVM9iv8C1zXv2K9tZBOWpBFPCKkLZBYSkl0UZAVpaBibJI2fAOLV8Q0aiOzmXBcBCKsBZAkA5IuZBDf0bZBtml9tJLM6idKvM0hifxqteQZAMNjDuFKsACKT54YCmN2iF2pfOkKXxX7m33ZACZCzbdeyTKhOBjOJdHxypPIZBYewv3hqpAZBCj5237AZDZD
WHATSAPP_PHONE_NUMBER_ID=896292656533055
WHATSAPP_VERIFY_TOKEN=CHANGE_THIS_VERIFY_TOKEN

# (اختياري) App Secret من إعدادات تطبيق Meta — إذا ضُبط، يُستخدم مستقبلاً
# للتحقق من توقيع طلبات الـ webhook الواردة (تعزيز أمني إضافي غير إلزامي)
#WHATSAPP_APP_SECRET=5dccc4c8efe8

# ---- حدود الطلبات (Rate Limiting) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# ---- طابور الرسائل الجماعية ----
# التأخير بالمللي ثانية بين كل رسالة والتي تليها في الإرسال الجماعي
BULK_MESSAGE_DELAY_MS=1200

# ---- CORS ----
# اضبطه على نطاق لوحة التحكم الفعلي عند النشر بدل *
CORS_ORIGIN=*
